# ============================================================================
# Eve v2 .env サンプル。これをコピーして `.env` を作る（`.env` は gitignore）。
#
# ⚠ 最重要: 下の【機能フラグ】は**コード既定が全て off**。ここに書かないと実起動
#   （tools/voice_chat.py）でタスク・検索・Call-Function・画面認識が丸ごと無効になる。
#   2026-07-28 の実機テストで、フラグ行が無いまま約1か月「機能が動かない」状態に
#   気づけなかった事故が実際に起きた（E2E ハーネスだけが強制 ON していたため）。
#   将来 UI から ON/OFF する前提なので、フラグは設定項目としてここに常に明記する。
# ============================================================================

# --- 機能フラグ（1=有効 / 0=無効）---
# CALLFUNCTION: 応答LLM への tools 提示と実行サイドカー（read-only 能力のみ）
CALLFUNCTION_ENABLED=1
# TASK: 予約タスク・TaskAgent・取消解決（CALLFUNCTION_ENABLED 前提）
TASK_ENABLED=1
# SEARCH: Web検索能力（**TASK_ENABLED 前提**。単独で 1 にしても無効）
SEARCH_ENABLED=1
# VLM: 画面認識（実際の画面を Gemini に送るので機密画面での起動に注意）
VLM_ENABLED=1
# WS: AI 専用の作業フォルダ（**TASK_ENABLED 前提**。単独で 1 にしても無効）
# 既定の場所は C:\eve_ws\workspace（リポジトリ外・.env と記憶ファイルから隔離するため）
WS_ENABLED=1
# WS_EXEC: 作業フォルダ内でのプログラム実行（**WS_ENABLED 前提**）
# 事前に「管理者 PowerShell で python setup_sandbox.py apply」が必要（専用アカウントを作る）
WS_EXEC_ENABLED=1
# WS_VIEWER: 作業フォルダの画像/テキストを別ウィンドウで画面表示（**WS_ENABLED 前提**）
# 管理者操作は不要。親アカウントの別プロセス Tk で開く
WS_VIEWER_ENABLED=1
# FILLER: ユーザの話し終わりに「あー」「えー」等のつなぎ言葉を鳴らし、応答の音声ができたら畳む。
# 語・比率・上限4秒・最短発話0.6秒・つなぎの間は fillers.yaml。音声は bank/<FILLER_VOICE>/
# （tools/build_filler_bank.py で作る・git 管理外）。**fillers.yaml の timing.join_gap_sec（つなぎの間）が
# 未決(null)の間は 1 にしても鳴らない**（聴き比べて決める: listen/s2/gap_*.wav）
FILLER_ENABLED=1
FILLER_TABLE=fillers.yaml
# 声のバンク。eve_calm = 語尾が上がらない候補を選んだもの（ユーザ採用 2026-09-26）。元のバンクは eve
# eve_calm_long = 1語 約1秒の長い版（ユーザ 2026-09-28「1フィラー、1〜1.5秒くらいが最適かも」→ 2026-09-29 試聴で
# 1秒に決定・fillers.yaml のつなぎの間 1.2秒と組）。短い版に戻すなら eve_calm（その時は timing.join_gap_sec も 0.4 に戻す）
FILLER_VOICE=eve_calm_long
# FILLER_DEPENDENT: fillers.yaml の応答依存フィラーの表（B 以下）と注記を、ユーザ発話への応答の
# system に入れて、応答の書き出しで言わせる（「へー、」「そっか、」等）。音を鳴らす FILLER とは独立
FILLER_DEPENDENT_ENABLED=1
# LAUGH: ユーザの話の「、」「。」ごとに「イブが思わず笑う場面か」を判定し（LAUGH_MODEL・既定 gpt-6-luna）、
# fillers.yaml の laugh.immediate 以上ならその場で笑う・laugh.filler 以上ならフィラーの中で笑う（laugh.filler_style: tone なら笑いの声色）。
# 前提: STT_BACKEND=openai_live（途中の文字が要る）・FILLER_ENABLED=1・笑いのバンク bank/<FILLER_VOICE>_laugh/
LAUGH_ENABLED=1
LAUGH_MODEL=openai/gpt-6-luna
# EMOTION: イブの今の感情（喜怒哀楽笑い）を、ユーザの話の「、」「。」ごと（EMOTION_MODEL・既定 gpt-6-luna）と
# フィードバックで更新し、応答LLM・フィードバックLLM・Irodori の声に使う（eve/emotion.py）。
# 声のトーン（感情ごとの絵文字）は emotion.yaml の voice_emoji（未決の間は付けない）。
# 「、」「。」ごとの判定は STT_BACKEND=openai_live が前提（無ければフィードバックでだけ更新）
EMOTION_ENABLED=1
EMOTION_MODEL=openai/gpt-6-luna
EMOTION_TABLE=emotion.yaml
# 感情は喜怒哀楽笑いの5つの数値（各0〜100・合計100以下・0=平常 50=はっきり 100=とても激しく）。
# EMOTION_DECAY_PER_HOUR: 判定した会話の時点から1時間あたりこれだけ引く（起動していない間も減る＝何日も前の感情は平常に戻る）
# EMOTION_TONE_MIN: 声とフィラーに感情を乗せるのは、いちばん強い感情がこの値以上の時だけ（弱い時は普通の声）
# EMOTION_STATE_FILE: 今の感情の保存先（判定のたびに書き、起動時に読む・.gitignore 済み）
EMOTION_DECAY_PER_HOUR=10
EMOTION_TONE_MIN=30
EMOTION_STATE_FILE=emotion_state.json
# FILLER_MOOD: ユーザの話の「、」「。」ごとに Jev（OpenRouter・OPENROUTER_API_KEY）へ聞き手の反応の種類（通常・悩む・驚く・
# 悲しむ・不満）を聞き、強い時だけフィラーの1段目をその種類の語にする（驚く→お 等。2段目以降は今までどおり）。
# 種類・語・しきい値は fillers.yaml の mood。前提: FILLER_ENABLED=1・STT_BACKEND=openai_live
FILLER_MOOD_ENABLED=1
# ALCHEMY: ユーザ作のブラウザ対戦ゲーム「Alchemy」（FlaskRondo）をイブが遊ぶ（eve/alchemy/）。前提: CALLFUNCTION_ENABLED=1
# ・普段はルールを会話に入れない。「Alchemy やろう」等と言われる（応答AI が alchemy_join を呼ぶ）か、画面認識が
#   ユーザの画面に Alchemy を見つけた時だけルールを入れる（画面からはゲームを始めない）
# ・遊ぶ時は合言葉（ALCHEMY_KEYWORD）の部屋に入って準備OKにする。ユーザも同じ合言葉で入って準備OKを押す
# ・イブは自分のゲーム画面を画面なしのブラウザ（PC の Chrome・Playwright）で開いて遊ぶ。部屋にいる間、
#   画面認識はイブのゲーム画面だけを見る（ユーザの画面は見ない）
# ・`pip install playwright` が要る（ブラウザは PC の Chrome を使うので playwright install は不要）
ALCHEMY_ENABLED=0
# ゲームの場所（ユーザがブラウザで開くのと同じ所）。本番 https://alchemy-game.fly.dev/ ・手元なら http://127.0.0.1:8000/
ALCHEMY_URL=https://alchemy-game.fly.dev/
ALCHEMY_KEYWORD=AIバトル
ALCHEMY_PLAYER_NAME=イブ
# 遊ばせ方: action＝1行動ごとに判断役（LLM）がコードの作った合法な候補から選ぶ /
#           strategy＝判断役はラウンドごとに作戦（多く送りたい素材・減らしたい素材）だけ決め、手はコードがその作戦で打つ
# どちらも判断役が締切に間に合わない・答えが崩れた時はコードの手で打つ
ALCHEMY_PLAY_MODE=action
# イブのゲーム画面を窓で出す（1 にすると、イブが何を見て何をしているかを横で見られる・既定 0＝画面なし）
ALCHEMY_SHOW_WINDOW=0
# イブの画面を動かすブラウザ（chrome＝PC の Chrome / 空＝Playwright 同梱の Chromium・要 playwright install chromium）
ALCHEMY_BROWSER_CHANNEL=chrome
# 準備（ルールを会話に入れた状態）を、この秒数 Alchemy の話が無ければ解く（部屋にいる間は解かない）
ALCHEMY_PREPARE_TTL_SEC=900
# 判断役のモデルは GAME_MODEL（下の「役割→モデル」）。reasoning_effort と1回に待つ上限[秒]
ALCHEMY_REASONING_EFFORT=low
ALCHEMY_MAX_THINK_SEC=20
# 部屋でイブだけが待ってこの秒数たったら、ユーザに来るかを確かめる（0 で無効）。確かめた後この秒数返事が無ければ、やめると伝えて抜ける
ALCHEMY_NUDGE_SEC=300
ALCHEMY_GIVEUP_SEC=30
# 確かめて返事はあったのに来ない（待ち直し）がこの回数たまったら、次は確かめずにやめると伝えて抜ける
ALCHEMY_MAX_REWAITS=2

# WS_VIEWER_MODE: イブの表示先。window=UI の「タスクウィンドウ」の中に集約（既定・
# 子ウィンドウは枠の外に出ない）/ external=従来どおり画面の好きな位置に別プロセスで開く。
# UI のチェックボックスから即時に切り替えられる。ヘッドレス実行（tools/voice_chat.py）は
# UI が無いので常に external と同じ動きになる。
WS_VIEWER_MODE=window

# UI_HIDE_FROM_CAPTURE: イブ自身のウィンドウ（Live2D UI・表示ビューア）を
# **イブの画面認識から隠す**。**この項目だけ既定 ON**（能力フラグではなくガードで、
# OFF は「自分のログと自分の顔をユーザの画面として実況する」既知の不具合状態＝D4/E11）。
# 有効な間は OBS 等の画面キャプチャからも消えるので、**配信する時だけ 0 にする**
# （配信中は画面認識を使わない想定なので通常は衝突しない）。UI のチェックボックスから
# 即時に切り替えられる（この設定だけ再起動不要）。Windows 10 2004 以降で有効。
UI_HIDE_FROM_CAPTURE=1

# TASKWIN_HIDE_FROM_CAPTURE: **タスクウィンドウと表示ビューア**を画面認識から隠す
# （既定 ON）。上の UI_HIDE_FROM_CAPTURE から分離した（2026-08-15）。0 にすると、
# 自分の UI は隠したまま**イブが自分の出した表示物だけ**を見られるようになる
# （作らせた電卓やグラフを一緒に見ながら話す用途）。
TASKWIN_HIDE_FROM_CAPTURE=1

# TASKWIN_HTML_ENABLED: タスクウィンドウで HTML を**動かして**表示する（既定 ON）。
# `pip install PySide6-Addons` が要る（入っていなければ自動でソース表示に落ちる）。
# イブに「押せるもの」（電卓・カウンタ等）を作らせる唯一の経路。
TASKWIN_HTML_ENABLED=1

# TASKWIN_PROTECT_CLICKS: 子ウィンドウを何回クリックしたら「ユーザが操作中」と見なし、
# イブの close_window や終了時の一括クローズから守るか（既定 3・0 で保護を切る）。
# 1 だと誤クリックで居座るため 3（ユーザ指定 2026-08-15）。
TASKWIN_PROTECT_CLICKS=3

# UI_ALWAYS_ON_TOP: ウィンドウを常に最前面に出す（既定 off）。作業しながら顔を見たい時に。
# 設定タブから変更でき、**次の起動から**効く。
UI_ALWAYS_ON_TOP=0

# AUTOSPEECH_ENABLED: 自律発話を**起動時に**有効にするか（既定 on＝従来の挙動）。
# メニューの［自律発話］は「今このセッションだけ」の切り替えで、こちらは「起動時の初期値」。
# 別物なので、メニューで切っても設定タブの表示は変わらない（UI_DESIGN の裁定 A）。
# 0 にすると起動時に沈黙監視と発話判定 worker を起こさない（あとでメニューから ON にできる）。
AUTOSPEECH_ENABLED=1

# USAGE_LOG_ENABLED: API 使用量と概算費用を記録する（既定 off）。役割ごとに1呼び出し1行の
# JSONL を残し、終了時にランの総額をログへ出す。集計は `tools/usage_report.py`。
# 価格は litellm の内蔵表（実測 3019 エントリ）から引く。**トークン数を必ず残す**ので、
# 価格表が古くなっても `--recalc` で当て直せる。
USAGE_LOG_ENABLED=0
USAGE_LOG_FILE=usage.jsonl
# 価格表が古い/未収載のモデルを使う時の手動修正。"model=入力単価:出力単価"（USD/token）を
# カンマ区切り。例: USAGE_PRICE_OVERRIDE=openai/gpt-5.5=5e-06:3e-05
USAGE_PRICE_OVERRIDE=

# --- API キー（Claude は現在停止中 → GPT/Gemini で代用）---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
TARGET_CHANNEL_ID=
# Jev（OpenRouter の decisions API・FILLER_MOOD で使う）
OPENROUTER_API_KEY=

# --- 応答の TTS（声）---
# irodori = Irodori-TTS（既定・応答もフィラーも同じ声）/ voicevox = VOICEVOX（切り替え用に残す）。
# **自動フォールバックはしない**（急に声が変わると不自然なので、話者はここで選ぶ）。
TTS_BACKEND=irodori
# Irodori サーバは EVE が自動で起動する（Irodori の venv の python で tools/irodori_server.py を動かす）。
# /health が通るサーバが既にあればそれを使う。EVE が落ちたら一緒に落ちる（Job Object）。
# 既定は「このリポジトリの隣の irodori-bench\Irodori-TTS」とその .venv の python。別の場所なら書く:
# IRODORI_REPO=D:\tools\Irodori-TTS
# IRODORI_PYTHON=D:\tools\Irodori-TTS\.venv\Scripts\python.exe
IRODORI_PORT=50030
# 話者の参照音声（リポジトリ基準の相対パス可）。**fillers.yaml の voices（フィラーのバンク）と同じ声にする**
IRODORI_VOICE_REF=voice_candidates/cand_04.wav
# steps と seed は聴き比べて決める（未決）。steps 6 は今のフィラーバンクと同じ値
# （実測 短い語 約211ms / steps 12 で 約338ms）。seed を固定すると同じ文は同じ音になる
IRODORI_STEPS=6
IRODORI_SEED=0
# 発話の区切り（「、」「。」）ごとの間[秒]。出力は開きっぱなし（2026-09-26）なので間はここで作る。
# 0.29 は試聴（listen/clause/）で良しとされた値＝以前の再生器が項目ごとに開き直して空いていた間
SPEECH_GAP_SEC=0.29

# --- 外部アプリ ---
# VOICEVOX は TTS_BACKEND=voicevox の時だけ使う（未起動でも落ちないが声が出ない）
VOICEVOX_URL=http://127.0.0.1:50021
# 未使用（読むコードがまだ無い。配線層PORT で使う予定）
VTS_PATH=
VOICEVOX_PATH=
VV_SPEAKER=1
VV_SPEED=1.0
VV_PITCH=0.0
# VV_INTONATION: 抑揚（VOICEVOX の intonationScale）。1.0 が VOICEVOX の既定なので、
# 明示しなければ今までと同じ音になる。0 に近いほど平坦、大きいほど起伏が強い。
VV_INTONATION=1.0

# --- 音声入力 / VAD（v1 実績設定）---
SAMPLE_RATE=16000
CHANNELS=1
VAD_THRESHOLD=0.5
SILENCE_LIMIT=0.5
# FILLER_START_DELAY_SEC: フィラー前の待ち[秒]。SILENCE_LIMIT で話し終わりと判定した後、さらにこれだけ待って
# からフィラーの1語目を鳴らす＝声が止まってから SILENCE_LIMIT＋これ（0.5＋0.5＝1.0秒）。その間にまた話し出したら
# 鳴らさない（話の途中の間でフィラーを被せない）。応答の速さは変わらない。0 で以前どおり。ユーザ決定 2026-10-09: 0.5
FILLER_START_DELAY_SEC=0.5
PREROLL_SEC=0.4
VAD_ONSET_SEC=0.12
# MIN_SPEECH_SEC: 最短発話ゲート[秒]。**声の長さ**がこれより短い区間は捨てる（0=長さでは捨てない＝既定）。
# 合成音の実測では「はい」「え？」「ね」「へー」が 0.096秒まで短くなる＝上げすぎると短い返事を取りこぼす。
# 自分の声と物音（咳・机・キーボード）を tools/short_utterance_probe.py で測ってから決める。
MIN_SPEECH_SEC=0

# --- STT（文字起こし）---
# openai_live = gpt-live-transcribe のストリーミング（話している間に送り、話し終わりで確定させる・
#   既定）。openai = gpt-4o-transcribe の一括（話し終わってから全体を送る）。groq は幻聴が多く
#   ロールバック用。**openai_live が失敗しても一括へ自動で切り替えない**（その発話は捨てて接続を張り直す）。
STT_BACKEND=openai_live
STT_MODEL=gpt-4o-transcribe
STT_LIVE_MODEL=gpt-live-transcribe
# delay: 実測で low が minimal より誤り率・確定の速さとも良かった（low 6.2%・commit→確定 中央0.55秒）
STT_LIVE_DELAY=low
# commit 後に確定が来ない時の打ち切り[秒]（実測 中央0.55秒・最大0.94秒の約5倍）
STT_LIVE_COMMIT_TIMEOUT_SEC=5.0

# --- 短期記憶（F3 ConversationCache）---
HISTORY_FILE=conversation_history.jsonl
HISTORY_MAX_TURNS=100
RECENT_TURN_COUNT=6

# --- 長期記憶（F3.5 RAG / 連想想起）---
RAG_FILE=rag_memory.jsonl
RAG_MAX_CHUNKS=500
RAG_TOP_K=3

EMBED_BACKEND=ruri
RURI_MODEL=cl-nagoya/ruri-v3-310m
EMBED_MODEL=text-embedding-3-small
RAG_W_REL=0.7
RAG_W_IMP=0.18
RAG_W_REC=0.12
RAG_RECENCY_TAU=86400
RAG_MMR_LAMBDA=0.7
RAG_DUP_HARDCUT=0.95
RAG_REL_BASELINE=0.77
RAG_RELEVANCE_FLOOR=0.15

# 自己モデル（イブの好み・趣向の台帳。会話から自己形成サイドカーが育てる）。
# 性格・口調は persona.md（別レイヤ）。ここは「好み」だけ。
SELF_MODEL_ENABLED=0
SELF_MODEL_FILE=self_model.jsonl

# --- 発話判定 / 自発発話（F5 + J-2）---
# 以下はコード既定で運用中（.env で上書きする必要は普段ない）。値の根拠は
# eve/config.py のコメント（実測校正の日付つき）を参照。
# SILENCE_TICK_SEC=0.7
# SILENCE_THRESHOLD_SEC=5.0
# SILENCE_MAX_INTERVAL_SEC=300   # 判定の間隔の上限（5秒から判定のたびに倍・ユーザかイブが話すと5秒に戻る）
# RAG_RANDOM_K=3
# RAG_TOPIC_JITTER=0.4
# RAG_AUTO_EXCLUDE_SEC=600        # 自律発話の関連枠から除外する「新しすぎる記憶」の窓
# SPEECH_LOG_MAX=10               # 観測用の発話判定ログ
# SPEECH_DUP_WINDOW_SEC=600       # 同内容抑制の比較窓
# SPEECH_DUP_LOG_MAX=50
# SPEECH_DUP_EMB_THRESHOLD=0.87   # 同内容抑制の二段目（埋め込み cos）

# --- 画面認識（F6）---
# VLM_MONITOR=1
# VLM_TARGET_FPS=2.0
# VLM_RING_MAX=6
# VLM_MAX_FRAMES_PER_CALL=3       # 2026-07-29 裁定: 1024/Q70/3枚 が正（実測で OCR 良好）
# VLM_PHASH_THRESHOLD=12
# VLM_PERIODIC_FRAMES=0
# VLM_MIN_INTERVAL_SEC=1.0
# VLM_DEDUP_RATIO=0.85
# VLM_DOWNSCALE_MAX=1024          # 同上。Q60 まで落とすと OCR が悪化するので JPEG 品質は 70 を維持
# VLM_JPEG_QUALITY=70
# VLM_VISION_TTL_SEC=7.0          # 自発発話系に画面を渡す鮮度上限
# VLM_STATIC_VISION_MAX_SEC=1800  # ユーザ応答のみ: 変化していない間の据え置き上限
#                                 # 180→600→1800 と実測で2回引き上げ（E6: 600 でも
#                                 # 1430秒前の正しい実況を捨てて「画面が見えない」と否認した）
# VLM_BLANK_STD_THRESHOLD=6.0
# 文字ゲート: pHash が拾えない「枠内の文字だけの変化」で画面認識を起こす二段目。
# 実測 2026-08-07: pHash 一致 15/15 ペアで画素完全一致 0/15・OCR 差分は最大24%
# ＝pHash は文字変化を見ていない。要 `pip install winsdk` + OCR 言語パック(ja)。
# **OCR の読み取りは LLM に一切渡さない**（誤読がハルシネの元）。用途は起こすか否かの判定だけ。
# VLM_OCR_ENABLED=1
# VLM_OCR_DIFF_PCT=25.0           # 何%変われば起こすか。鈍めが正（文章作成中に鳴り続けないため）
                                  # 実測(制御実験): 12行中1行=4.1% / 3行=10.5% / 6行=20.1%・ノイズ床は最大1.3%
                                  # 実測(実機): 作文中の発火は 10%→3.9回/分 / 25%→0.8 / 30%→0
                                  #             通常利用の検知は 10%→0.51回/分 / 25%→0.34（ほぼ維持）
# VLM_OCR_INTERVAL_SEC=3.0        # OCR の最短間隔（1判定 337ms＝duty 約11%）
# VLM_OCR_DOWNSCALE=1600          # OCR 用キャプチャの長辺（送信用の 1024/JPEG より高精細にする）

# --- タスク（J-1）/ 検索（J-2）---
# TASK_FILE=tasks.jsonl
# TASK_MAX=500
# TASK_RECONCILE_TICK_SEC=1.0
# TASK_ORPHAN_TIMEOUT_SEC=3600
# TASK_AGENT_MAX_STEPS=5
# TASK_AGENT_TIMEOUT_SEC=180.0
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT_SEC=20.0
# SEARCH_SOCKET_TIMEOUT_SEC=5.0
# SEARCH_CACHE_TTL_SEC=600.0
# SEARCH_COOLDOWN_SEC=90.0
# SEARCH_MIN_INTERVAL_SEC=5.0
# SEARCH_RETRY_EMPTY_DELAY_SEC=8.0
# SEARCH_BACKEND=auto             # DNS 遮断回線では duckduckgo 固定に戻す
# SEARCH_DNS_RESOLVER=system      # 検索ライブラリの名前解決。system=OS と同じ（既定）。空=ライブラリ任せ
#                                 # （ライブラリ任せだと、問い合わせを拒否する IPv6 の DNS で全滅した・実測 2026-09-28）

# --- 作業フォルダ（J-3）---
# WS_ROOT=                        # 空=C:\eve_ws\workspace。**リポジトリ配下は拒否される**
# WS_QUOTA_GB=128                 # 超過しても削除はしない（新規書込だけ断る）
# WS_WRITE_MAX_CHARS=200000       # 1回の書込上限
# WS_READ_MAX_CHARS=4000          # LLM に返す上限（ファイル自体の上限とは別物）
# WS_MAX_FILES=20000              # 走査の bound
# WS_RESCAN_SEC=600               # 台帳ドリフトの定期補正
# WS_EXEC_ALLOW=python,pip,git,ffmpeg,curl,tar,7z,node,npm
#                                 # ↑ **セキュリティ境界ではない**（python を許した時点で任意
#                                 #   コード実行。本当の境界は専用アカウント+ACL+Job Object）
# WS_RUN_TIMEOUT_SEC=60           # 内側（runner の subprocess）
# WS_RUN_GRACE_SEC=10             # 外側の猶予（Job 強制終了まで）
# WS_RUN_MEM_MB=2048
# WS_RUN_MAX_PROCS=32             # fork bomb 対策
# WS_MAX_OUTPUT_CHARS=8000        # LLM に返す出力上限
# WS_VIEWER_MAX_WINDOWS=5         # 同時に開ける窓の上限（超えたら開かずに断る）

# --- 役割→モデル（ModelRegistry 既定の上書き）---
# 実運用値。response は 2026-09-29 に gpt-6-luna を採用（ユーザ「ルナは採用」・旧 gpt-5.5）。
# 実測: 雑談の最初の「、。」まで 0.66〜1.0秒（gpt-5.5 は 1.2〜4.2秒）。
# **gpt-6-luna はツール付きだと reasoning_effort=none 必須**（無いとユーザ発話への応答が BadRequest で全部失敗する）
# 2026-10-04 ユーザ「応答AIは Gemini に切り替えたい」: 性格 N8＋会話例で gemini-3.8-flash が一番 AI くさくなかった（最初の文字まで中央 約1.6〜1.9秒・1時間 約 $1.2）。reasoning_effort は low（無いと考える工程で遅い）
RESPONSE_MODEL=gemini/gemini-3.8-flash
RESPONSE_REASONING_EFFORT=low
# 話し方の実例（性格 persona.md の後に、実際のやりとりを毎回ランダムに見せる・eve/persona_examples.py）。0＝使わない。
# 実例そのものは persona_examples.yaml（人が選ぶ・空なら使わない）。今の話しかけと意味が近い実例は見せない（丸写し防止）。
# 実測 2026-10-01: 0/2/4/8/16 個で Neuro-sama の実際の返事との差 0.162/0.167/0.159/0.134/0.133 → 8
PERSONA_EXAMPLES_K=8
# PERSONA_EXAMPLES_FILE=persona_examples.yaml
# 性格と実例の中身は手元だけ（.gitignore 済み・コミットしない）。性格は persona.local.md があればそれ、
# 無ければ persona.md（リポジトリの書式の見本）。別の場所に置くなら PERSONA_FILE で指定（最優先）
# PERSONA_FILE=persona.local.md
# DECIDE_MODEL: ユーザ決定 2026-09-30「発話判定はルナで良さそう」（本番の組み立て・10場面×2回で 18/20・1回 $0.00015。
# gpt-6-sol 20/20 は1回 $0.0028・今までの gpt-5.4-mini は 14/20）
DECIDE_MODEL=openai/gpt-6-luna
# FEEDBACK_MODEL / TASK_MODEL: ユーザ決定 2026-09-29「フィードバック、タスクは sonnet5.5 で良さそう」＝ anthropic/claude-sonnet-5-5
# （**ANTHROPIC_API_KEY とクレジット残高が要る**。残高不足だと "Your credit balance is too low" で全部失敗する）。
# 実測（本番の組み立て・2026-09-29）: フィードバック 3.6〜3.8秒（gpt-5.4 は 6〜7秒）・形式の崩れなし /
# タスクのループ（tools/task_agent_probe.py の3ゴール）完走・3ゴールで $0.021（gpt-5.5 は $0.037）
FEEDBACK_MODEL=anthropic/claude-sonnet-5-5
TASK_MODEL=anthropic/claude-sonnet-5-5
# VLM_LEAF_MODEL: ユーザ決定 2026-09-30「画面認識GPT6ルナに変更」。改善版プロンプト（eve/vlm/narrator.py）で Sintel の3コマ×10場面
# 総合 90.4（gemini-3.5-flash-lite 82.9・今までの gemini-2.5-flash は旧プロンプトで 51.9）・1回 $0.0003・3.6秒。
# 映画を流しっぱなしの実測で画面認識は約 19回/分・約 $0.46/時（gemini-3.5-flash-lite は 30回/分・$2.33/時）
VLM_LEAF_MODEL=openai/gpt-6-luna
VLM_MERGE_MODEL=gemini/gemini-2.5-pro
YOUTUBE_MODEL=openai/gpt-4o
SUMMARIZE_MODEL=openai/gpt-4o-mini
# 2026-10-01 ユーザ決定「配達と要約はルナに変えていい」。正解つきの問題集（tools/prompt_eval/sidecars.py）で
# 配達確認 gpt-5.4 19/24 → ルナ 24/24（伝わっていないのに伝わった扱いが 5→0）・検索要約 gpt-4o-mini 11/12 → ルナ 12/12。
# 単価はルナが最安（入力 $0.10/M）
DELIVERY_CHECK_MODEL=openai/gpt-6-luna
SEARCH_SUMMARIZE_MODEL=openai/gpt-6-luna
# GAME_MODEL: Alchemy の手を決める判断役（ALCHEMY_ENABLED=1 の時だけ・1ラウンドに 1〜3回・締切つき）
GAME_MODEL=openai/gpt-6-luna
# 以下はコード既定で運用中（.env に書かなくても動く）
# SELF_MODEL_MODEL=openai/gpt-5.4

# 注: ここに「追記」ブロックがあった場合、設定タブの保存が自動で足したもの。
# 2026-08-15 に一度、検証ランのテスト値（VLM_PHASH_THRESHOLD=7 等）が書き込まれた。
# 原因は (a) コメント行のキーを「未記載」と誤判定 (b) サンドボックス中も本物の
# `.env.example` を見ていた の2点で、どちらも `eve/settings_store.py` で修正済み。
