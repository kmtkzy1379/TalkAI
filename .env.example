# --- API キー（Claude は現在停止中 → GPT/Gemini で代用） ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
TARGET_CHANNEL_ID=

# --- 外部アプリ ---
VOICEVOX_URL=http://127.0.0.1:50021
VTS_PATH=
VOICEVOX_PATH=
# VOICEVOX 合成パラメータ
VV_SPEAKER=1
VV_SPEED=1.0
VV_PITCH=0.0

# --- 役割→モデル（ModelRegistry 既定の上書き。実装時に有効モデルIDを検証する） ---
RESPONSE_MODEL=openai/gpt-4o
DECIDE_MODEL=openai/gpt-4o-mini
FEEDBACK_MODEL=openai/gpt-4o-mini
VLM_LEAF_MODEL=gemini/gemini-2.5-flash
VLM_MERGE_MODEL=gemini/gemini-2.5-pro
YOUTUBE_MODEL=openai/gpt-4o
SUMMARIZE_MODEL=openai/gpt-4o-mini
