# ============================================================================
# Eve v2 .env サンプル。これをコピーして `.env` を作る（`.env` は gitignore）。
#
# ⚠ 最重要: 下の【機能フラグ】は**コード既定が全て off**。ここに書かないと実起動
#   （tools/voice_chat.py）でタスク・検索・Call-Function・画面認識が丸ごと無効になる。
#   2026-07-28 の実機テストで、フラグ行が無いまま約1か月「機能が動かない」状態に
#   気づけなかった事故が実際に起きた（E2E ハーネスだけが強制 ON していたため）。
#   将来 UI から ON/OFF する前提なので、フラグは設定項目としてここに常に明記する。
# ============================================================================

# --- 機能フラグ（1=有効 / 0=無効）---
# CALLFUNCTION: 応答LLM への tools 提示と実行サイドカー（read-only 能力のみ）
CALLFUNCTION_ENABLED=1
# TASK: 予約タスク・TaskAgent・取消解決（CALLFUNCTION_ENABLED 前提）
TASK_ENABLED=1
# SEARCH: Web検索能力（**TASK_ENABLED 前提**。単独で 1 にしても無効）
SEARCH_ENABLED=1
# VLM: 画面認識（実際の画面を Gemini に送るので機密画面での起動に注意）
VLM_ENABLED=1
# WS: AI 専用の作業フォルダ（**TASK_ENABLED 前提**。単独で 1 にしても無効）
# 既定の場所は C:\eve_ws\workspace（リポジトリ外・.env と記憶ファイルから隔離するため）
WS_ENABLED=1
# WS_EXEC: 作業フォルダ内でのプログラム実行（**WS_ENABLED 前提**）
# 事前に「管理者 PowerShell で python setup_sandbox.py apply」が必要（専用アカウントを作る）
WS_EXEC_ENABLED=1
# WS_VIEWER: 作業フォルダの画像/テキストを別ウィンドウで画面表示（**WS_ENABLED 前提**）
# 管理者操作は不要。親アカウントの別プロセス Tk で開く
WS_VIEWER_ENABLED=1

# WS_VIEWER_MODE: イブの表示先。window=UI の「タスクウィンドウ」の中に集約（既定・
# 子ウィンドウは枠の外に出ない）/ external=従来どおり画面の好きな位置に別プロセスで開く。
# UI のチェックボックスから即時に切り替えられる。ヘッドレス実行（tools/voice_chat.py）は
# UI が無いので常に external と同じ動きになる。
WS_VIEWER_MODE=window

# UI_HIDE_FROM_CAPTURE: イブ自身のウィンドウ（Live2D UI・表示ビューア）を
# **イブの画面認識から隠す**。**この項目だけ既定 ON**（能力フラグではなくガードで、
# OFF は「自分のログと自分の顔をユーザの画面として実況する」既知の不具合状態＝D4/E11）。
# 有効な間は OBS 等の画面キャプチャからも消えるので、**配信する時だけ 0 にする**
# （配信中は画面認識を使わない想定なので通常は衝突しない）。UI のチェックボックスから
# 即時に切り替えられる（この設定だけ再起動不要）。Windows 10 2004 以降で有効。
UI_HIDE_FROM_CAPTURE=1

# UI_ALWAYS_ON_TOP: ウィンドウを常に最前面に出す（既定 off）。作業しながら顔を見たい時に。
# 設定タブから変更でき、**次の起動から**効く。
UI_ALWAYS_ON_TOP=0

# AUTOSPEECH_ENABLED: 自律発話を**起動時に**有効にするか（既定 on＝従来の挙動）。
# メニューの［自律発話］は「今このセッションだけ」の切り替えで、こちらは「起動時の初期値」。
# 別物なので、メニューで切っても設定タブの表示は変わらない（UI_DESIGN の裁定 A）。
# 0 にすると起動時に沈黙監視と発話判定 worker を起こさない（あとでメニューから ON にできる）。
AUTOSPEECH_ENABLED=1

# USAGE_LOG_ENABLED: API 使用量と概算費用を記録する（既定 off）。役割ごとに1呼び出し1行の
# JSONL を残し、終了時にランの総額をログへ出す。集計は `tools/usage_report.py`。
# 価格は litellm の内蔵表（実測 3019 エントリ）から引く。**トークン数を必ず残す**ので、
# 価格表が古くなっても `--recalc` で当て直せる。
USAGE_LOG_ENABLED=0
USAGE_LOG_FILE=usage.jsonl
# 価格表が古い/未収載のモデルを使う時の手動修正。"model=入力単価:出力単価"（USD/token）を
# カンマ区切り。例: USAGE_PRICE_OVERRIDE=openai/gpt-5.5=5e-06:3e-05
USAGE_PRICE_OVERRIDE=

# --- API キー（Claude は現在停止中 → GPT/Gemini で代用）---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
TARGET_CHANNEL_ID=

# --- 外部アプリ ---
# VOICEVOX は実起動・音声E2Eで必須（未起動でも落ちないが声が出ない）
VOICEVOX_URL=http://127.0.0.1:50021
# 未使用（読むコードがまだ無い。配線層PORT で使う予定）
VTS_PATH=
VOICEVOX_PATH=
VV_SPEAKER=1
VV_SPEED=1.0
VV_PITCH=0.0
# VV_INTONATION: 抑揚（VOICEVOX の intonationScale）。1.0 が VOICEVOX の既定なので、
# 明示しなければ今までと同じ音になる。0 に近いほど平坦、大きいほど起伏が強い。
VV_INTONATION=1.0

# --- 音声入力 / VAD（v1 実績設定）---
SAMPLE_RATE=16000
CHANNELS=1
VAD_THRESHOLD=0.5
SILENCE_LIMIT=0.5
PREROLL_SEC=0.4
VAD_ONSET_SEC=0.12

# --- STT（既定 gpt-4o-transcribe。groq は幻聴が多くロールバック用）---
STT_BACKEND=openai
STT_MODEL=gpt-4o-transcribe

# --- 短期記憶（F3 ConversationCache）---
HISTORY_FILE=conversation_history.jsonl
HISTORY_MAX_TURNS=100
RECENT_TURN_COUNT=6

# --- 長期記憶（F3.5 RAG / 連想想起）---
RAG_FILE=rag_memory.jsonl
RAG_MAX_CHUNKS=500
RAG_TOP_K=3
EMBED_BACKEND=ruri
RURI_MODEL=cl-nagoya/ruri-v3-310m
EMBED_MODEL=text-embedding-3-small
RAG_W_REL=0.7
RAG_W_IMP=0.18
RAG_W_REC=0.12
RAG_RECENCY_TAU=86400
RAG_MMR_LAMBDA=0.7
RAG_DUP_HARDCUT=0.95
RAG_REL_BASELINE=0.77
RAG_RELEVANCE_FLOOR=0.15

# --- 発話判定 / 自発発話（F5 + J-2）---
# 以下はコード既定で運用中（.env で上書きする必要は普段ない）。値の根拠は
# eve/config.py のコメント（実測校正の日付つき）を参照。
# SILENCE_TICK_SEC=0.7
# SILENCE_THRESHOLD_SEC=5.0
# RAG_RANDOM_K=3
# RAG_TOPIC_JITTER=0.4
# RAG_AUTO_EXCLUDE_SEC=600        # 自律発話の関連枠から除外する「新しすぎる記憶」の窓
# SPEECH_LOG_MAX=10               # 観測用の発話判定ログ
# SPEECH_DUP_WINDOW_SEC=600       # 同内容抑制の比較窓
# SPEECH_DUP_LOG_MAX=50
# SPEECH_DUP_EMB_THRESHOLD=0.87   # 同内容抑制の二段目（埋め込み cos）

# --- 画面認識（F6）---
# VLM_MONITOR=1
# VLM_TARGET_FPS=2.0
# VLM_RING_MAX=6
# VLM_MAX_FRAMES_PER_CALL=3       # 2026-07-29 裁定: 1024/Q70/3枚 が正（実測で OCR 良好）
# VLM_PHASH_THRESHOLD=12
# VLM_PERIODIC_FRAMES=0
# VLM_MIN_INTERVAL_SEC=1.0
# VLM_DEDUP_RATIO=0.85
# VLM_DOWNSCALE_MAX=1024          # 同上。Q60 まで落とすと OCR が悪化するので JPEG 品質は 70 を維持
# VLM_JPEG_QUALITY=70
# VLM_VISION_TTL_SEC=7.0          # 自発発話系に画面を渡す鮮度上限
# VLM_STATIC_VISION_MAX_SEC=1800  # ユーザ応答のみ: 変化していない間の据え置き上限
#                                 # 180→600→1800 と実測で2回引き上げ（E6: 600 でも
#                                 # 1430秒前の正しい実況を捨てて「画面が見えない」と否認した）
# VLM_BLANK_STD_THRESHOLD=6.0
# 文字ゲート: pHash が拾えない「枠内の文字だけの変化」で画面認識を起こす二段目。
# 実測 2026-08-07: pHash 一致 15/15 ペアで画素完全一致 0/15・OCR 差分は最大24%
# ＝pHash は文字変化を見ていない。要 `pip install winsdk` + OCR 言語パック(ja)。
# **OCR の読み取りは LLM に一切渡さない**（誤読がハルシネの元）。用途は起こすか否かの判定だけ。
# VLM_OCR_ENABLED=1
# VLM_OCR_DIFF_PCT=25.0           # 何%変われば起こすか。鈍めが正（文章作成中に鳴り続けないため）
                                  # 実測(制御実験): 12行中1行=4.1% / 3行=10.5% / 6行=20.1%・ノイズ床は最大1.3%
                                  # 実測(実機): 作文中の発火は 10%→3.9回/分 / 25%→0.8 / 30%→0
                                  #             通常利用の検知は 10%→0.51回/分 / 25%→0.34（ほぼ維持）
# VLM_OCR_INTERVAL_SEC=3.0        # OCR の最短間隔（1判定 337ms＝duty 約11%）
# VLM_OCR_DOWNSCALE=1600          # OCR 用キャプチャの長辺（送信用の 1024/JPEG より高精細にする）

# --- タスク（J-1）/ 検索（J-2）---
# TASK_FILE=tasks.jsonl
# TASK_MAX=500
# TASK_RECONCILE_TICK_SEC=1.0
# TASK_ORPHAN_TIMEOUT_SEC=3600
# TASK_AGENT_MAX_STEPS=5
# TASK_AGENT_TIMEOUT_SEC=180.0
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT_SEC=20.0
# SEARCH_SOCKET_TIMEOUT_SEC=5.0
# SEARCH_CACHE_TTL_SEC=600.0
# SEARCH_COOLDOWN_SEC=90.0
# SEARCH_MIN_INTERVAL_SEC=5.0
# SEARCH_RETRY_EMPTY_DELAY_SEC=8.0
# SEARCH_BACKEND=auto             # DNS 遮断回線では duckduckgo 固定に戻す

# --- 作業フォルダ（J-3）---
# WS_ROOT=                        # 空=C:\eve_ws\workspace。**リポジトリ配下は拒否される**
# WS_QUOTA_GB=128                 # 超過しても削除はしない（新規書込だけ断る）
# WS_WRITE_MAX_CHARS=200000       # 1回の書込上限
# WS_READ_MAX_CHARS=4000          # LLM に返す上限（ファイル自体の上限とは別物）
# WS_MAX_FILES=20000              # 走査の bound
# WS_RESCAN_SEC=600               # 台帳ドリフトの定期補正
# WS_EXEC_ALLOW=python,pip,git,ffmpeg,curl,tar,7z,node,npm
#                                 # ↑ **セキュリティ境界ではない**（python を許した時点で任意
#                                 #   コード実行。本当の境界は専用アカウント+ACL+Job Object）
# WS_RUN_TIMEOUT_SEC=60           # 内側（runner の subprocess）
# WS_RUN_GRACE_SEC=10             # 外側の猶予（Job 強制終了まで）
# WS_RUN_MEM_MB=2048
# WS_RUN_MAX_PROCS=32             # fork bomb 対策
# WS_MAX_OUTPUT_CHARS=8000        # LLM に返す出力上限
# WS_VIEWER_MAX_WINDOWS=5         # 同時に開ける窓の上限（超えたら開かずに断る）

# --- 役割→モデル（ModelRegistry 既定の上書き）---
# 実運用値（2026-07-29 時点）。response は品質重視で gpt-5.5（レイテンシは要監視）
RESPONSE_MODEL=openai/gpt-5.5
DECIDE_MODEL=openai/gpt-5.4-mini
FEEDBACK_MODEL=openai/gpt-5.4
VLM_LEAF_MODEL=gemini/gemini-2.5-flash
VLM_MERGE_MODEL=gemini/gemini-2.5-pro
YOUTUBE_MODEL=openai/gpt-4o
SUMMARIZE_MODEL=openai/gpt-4o-mini
# 以下はコード既定で運用中（.env に書かなくても動く）
# TASK_MODEL=openai/gpt-5.5
# SEARCH_SUMMARIZE_MODEL=openai/gpt-4o-mini
# DELIVERY_CHECK_MODEL=openai/gpt-4o-mini

# 注: ここに「追記」ブロックがあった場合、設定タブの保存が自動で足したもの。
# 2026-08-15 に一度、検証ランのテスト値（VLM_PHASH_THRESHOLD=7 等）が書き込まれた。
# 原因は (a) コメント行のキーを「未記載」と誤判定 (b) サンドボックス中も本物の
# `.env.example` を見ていた の2点で、どちらも `eve/settings_store.py` で修正済み。
