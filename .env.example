# --- API キー（Claude は現在停止中 → GPT/Gemini で代用） ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
TARGET_CHANNEL_ID=

# --- 外部アプリ ---
VOICEVOX_URL=http://127.0.0.1:50021
VTS_PATH=
VOICEVOX_PATH=
# VOICEVOX 合成パラメータ
VV_SPEAKER=1
VV_SPEED=1.0
VV_PITCH=0.0

# 音声入力 / VAD（v1 実績設定）
SAMPLE_RATE=16000
CHANNELS=1
VAD_THRESHOLD=0.5
SILENCE_LIMIT=0.5
PREROLL_SEC=0.4
VAD_ONSET_SEC=0.12

# STT（既定 gpt-4o-transcribe。groq は幻聴多くロールバック用）
STT_BACKEND=openai
STT_MODEL=gpt-4o-transcribe

# 短期記憶（F3 ConversationCache）
# 会話ログ JSONL の保存先（タイムスタンプ付き・最新 HISTORY_MAX_TURNS 件を保持）
HISTORY_FILE=conversation_history.jsonl
HISTORY_MAX_TURNS=100
# 応答LLM に注入する直近ターン数（≈3往復）
RECENT_TURN_COUNT=6

# 長期記憶（F3.5 RAG / 連想想起）
RAG_FILE=rag_memory.jsonl
RAG_MAX_CHUNKS=500
RAG_TOP_K=3
# 埋め込み backend: ruri(ローカル日本語特化・既定) | openai(API)
EMBED_BACKEND=ruri
RURI_MODEL=cl-nagoya/ruri-v3-310m
EMBED_MODEL=text-embedding-3-small
# memory-stream ランキング（relevance最優先・importance控えめ・recency弱め。実測 sweep で調整）
RAG_W_REL=0.6
RAG_W_IMP=0.25
RAG_W_REC=0.15
RAG_RECENCY_TAU=86400
RAG_MMR_LAMBDA=0.7
RAG_DUP_HARDCUT=0.95
# 埋め込み異方性の補正基準（Ruri/e5系は~0.75、生コサインなら0.0）
RAG_REL_BASELINE=0.75
# 関連度フロア（再スケール後の rel' に対して）
RAG_RELEVANCE_FLOOR=0.1

# --- 役割→モデル（ModelRegistry 既定の上書き。実装時に有効モデルIDを検証する） ---
RESPONSE_MODEL=openai/gpt-4o
DECIDE_MODEL=openai/gpt-4o-mini
FEEDBACK_MODEL=openai/gpt-4o-mini
VLM_LEAF_MODEL=gemini/gemini-2.5-flash
VLM_MERGE_MODEL=gemini/gemini-2.5-pro
YOUTUBE_MODEL=openai/gpt-4o
SUMMARIZE_MODEL=openai/gpt-4o-mini
