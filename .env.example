# --- API キー（Claude は現在停止中 → GPT/Gemini で代用） ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
TARGET_CHANNEL_ID=

# --- 外部アプリ ---
VOICEVOX_URL=http://127.0.0.1:50021
VTS_PATH=
VOICEVOX_PATH=
# VOICEVOX 合成パラメータ
VV_SPEAKER=1
VV_SPEED=1.0
VV_PITCH=0.0

# 音声入力 / VAD（v1 実績設定）
SAMPLE_RATE=16000
CHANNELS=1
VAD_THRESHOLD=0.5
SILENCE_LIMIT=0.5
PREROLL_SEC=0.4
VAD_ONSET_SEC=0.12

# STT（既定 gpt-4o-transcribe。groq は幻聴多くロールバック用）
STT_BACKEND=openai
STT_MODEL=gpt-4o-transcribe

# 短期記憶（F3 ConversationCache）
# 会話ログ JSONL の保存先（タイムスタンプ付き・最新 HISTORY_MAX_TURNS 件を保持）
HISTORY_FILE=conversation_history.jsonl
HISTORY_MAX_TURNS=100
# 応答LLM に注入する直近ターン数（≈3往復）
RECENT_TURN_COUNT=6

# --- 役割→モデル（ModelRegistry 既定の上書き。実装時に有効モデルIDを検証する） ---
RESPONSE_MODEL=openai/gpt-4o
DECIDE_MODEL=openai/gpt-4o-mini
FEEDBACK_MODEL=openai/gpt-4o-mini
VLM_LEAF_MODEL=gemini/gemini-2.5-flash
VLM_MERGE_MODEL=gemini/gemini-2.5-pro
YOUTUBE_MODEL=openai/gpt-4o
SUMMARIZE_MODEL=openai/gpt-4o-mini
